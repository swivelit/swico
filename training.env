# Swico CPU retrieval training configuration
#
# Precedence: command line > shell environment > this file > profile defaults.
# Use "auto" for profile-controlled values. This lets
#   SWICO_PROFILE=smoke ./run_vm_training.sh
# safely switch to the smoke profile without editing this file.

SWICO_CONFIG_STRICT=true
SWICO_PROFILE=vm

# Paths and model
SWICO_DATA_PATH=data.csv
SWICO_OUTPUT_DIR=training_artifacts/e5-small-swico
SWICO_BASE_MODEL=intfloat/multilingual-e5-small

# Runtime
SWICO_CPU_THREADS=8
SWICO_SEED=42
SWICO_BF16=auto
SWICO_RESUME=true
SWICO_OFFLINE=false
SWICO_PREPARE_ONLY=false
SWICO_SKIP_BASE_EVAL=false
SWICO_KEEP_INTERMEDIATE=false
SWICO_KEEP_CHECKPOINTS=false
SWICO_OVERWRITE_OUTPUT=false

# Dataset cleaning and leakage-resistant split
SWICO_BOILERPLATE_THRESHOLD=100
SWICO_MAX_TRAIN_ROWS=auto
SWICO_TRAIN_SPLIT_FRACTION=0.80
SWICO_VALIDATION_SPLIT_FRACTION=0.10
SWICO_TEST_SPLIT_FRACTION=0.10

# Model and training profile overrides
SWICO_BATCH_SIZE=auto
SWICO_MAX_SEQ_LENGTH=auto
SWICO_TRAINABLE_LAYERS=auto
SWICO_STAGE1_EPOCHS=auto
SWICO_STAGE2_EPOCHS=auto
SWICO_STAGE1_LR=0.00002
SWICO_STAGE2_LR=0.000008
SWICO_WEIGHT_DECAY=0.01
SWICO_WARMUP_RATIO=0.06
SWICO_LR_SCHEDULER_TYPE=cosine
SWICO_GRADIENT_ACCUMULATION_STEPS=1
SWICO_MAX_GRAD_NORM=1.0
SWICO_GRADIENT_CHECKPOINTING=false
SWICO_DATALOADER_NUM_WORKERS=0
SWICO_DATALOADER_DROP_LAST=true
SWICO_LOGGING_STEPS=25
SWICO_SAVE_TOTAL_LIMIT=2

# Validation and best-model selection
SWICO_EVAL_BATCH_SIZE=64
SWICO_EVAL_LOSS_ROWS=512
SWICO_EVAL_CORPUS_CHUNK_SIZE=5000
SWICO_EVAL_QUERIES=auto
SWICO_EVAL_CORPUS=auto
SWICO_EARLY_STOPPING=true
SWICO_EARLY_STOPPING_PATIENCE=2
SWICO_EARLY_STOPPING_THRESHOLD=0.001
SWICO_LOAD_BEST_MODEL_AT_END=true

# Hard-negative curriculum
SWICO_HARD_NEGATIVES=auto
SWICO_MINING_TOP_K=auto
SWICO_MIN_HARD_NEGATIVE_MARGIN=0.02
SWICO_MINING_BATCH_SIZE=64
SWICO_MINING_CHUNK_SIZE=512
SWICO_HNSW_M=32
SWICO_HNSW_EF_CONSTRUCTION=80
SWICO_HNSW_EF_SEARCH_FACTOR=4
SWICO_NEGATIVE_MAX_TOKEN_JACCARD=0.88

# Retrieval loss and Matryoshka embeddings
SWICO_LOSS_SCALE=20.0
SWICO_MATRYOSHKA_DIMS=auto
SWICO_MATRYOSHKA_WEIGHTS=1.0,0.35,0.35
SWICO_MATRYOSHKA_DIMS_PER_STEP=-1

# Preflight safety limits
SWICO_MIN_AVAILABLE_MEMORY_GIB=8.0
SWICO_MIN_FREE_DISK_GIB=2.0
SWICO_WARN_FREE_DISK_GIB=4.0
