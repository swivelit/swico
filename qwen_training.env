# Swico Qwen3-0.6B CPU LoRA conversational training configuration
# Precedence: command line > shell environment > this file > profile defaults.
# Use "auto" where supported to inherit profile/runtime defaults.

SWICO_CONFIG_STRICT=true
SWICO_QWEN_PROFILE=vm

# Model and conversational CSV
SWICO_QWEN_DATA_PATH=data/qwen_dataset - qwen_dataset.csv
SWICO_QWEN_BASE_MODEL=Qwen/Qwen3-0.6B

# Timestamped output runs
SWICO_QWEN_OUTPUT_ROOT=training_artifacts/qwen3-0.6b-swico
SWICO_QWEN_OUTPUT_DIR=auto
SWICO_QWEN_RUN_MODE=auto
SWICO_QWEN_RUN_LABEL=auto
SWICO_QWEN_CREATE_LATEST_LINKS=true

# CPU runtime
SWICO_QWEN_CPU_THREADS=8
SWICO_QWEN_SEED=42
SWICO_QWEN_BF16=auto
SWICO_QWEN_OFFLINE=false
SWICO_QWEN_RESUME=true
SWICO_QWEN_PREPARE_ONLY=false

# Conversation-level leakage-resistant split
SWICO_QWEN_MAX_CONVERSATIONS=auto
SWICO_QWEN_TRAIN_SPLIT_FRACTION=0.80
SWICO_QWEN_VALIDATION_SPLIT_FRACTION=0.10
SWICO_QWEN_TEST_SPLIT_FRACTION=0.10

# Profile defaults when auto:
# smoke: max 64 conversations, 1 epoch, seq 512, batch 1, grad accumulation 4, 4 generations
# vm:    max 12000 conversations, 2 epochs, seq 512, batch 1, grad accumulation 16, 40 generations
# full:  all conversations, 3 epochs, seq 768, batch 1, grad accumulation 16
SWICO_QWEN_MAX_SEQ_LENGTH=auto
SWICO_QWEN_EPOCHS=auto
SWICO_QWEN_BATCH_SIZE=auto
SWICO_QWEN_EVAL_BATCH_SIZE=1
SWICO_QWEN_GRADIENT_ACCUMULATION_STEPS=auto

# Optimizer / scheduler
SWICO_QWEN_LEARNING_RATE=0.00005
SWICO_QWEN_WEIGHT_DECAY=0.01
SWICO_QWEN_WARMUP_RATIO=0.05
SWICO_QWEN_LR_SCHEDULER_TYPE=cosine
SWICO_QWEN_MAX_GRAD_NORM=1.0
SWICO_QWEN_GRADIENT_CHECKPOINTING=true
SWICO_QWEN_LOGGING_STEPS=5
SWICO_QWEN_SAVE_TOTAL_LIMIT=2
SWICO_QWEN_EVAL_STEPS=auto
SWICO_QWEN_SAVE_STEPS=auto
SWICO_QWEN_DATALOADER_NUM_WORKERS=0

# LoRA / PEFT. Base weights remain frozen.
SWICO_QWEN_LORA_R=8
SWICO_QWEN_LORA_ALPHA=16
SWICO_QWEN_LORA_DROPOUT=0.05
SWICO_QWEN_LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# Validation-driven stopping and best checkpoint restoration
SWICO_QWEN_EARLY_STOPPING=true
SWICO_QWEN_EARLY_STOPPING_PATIENCE=3
SWICO_QWEN_EARLY_STOPPING_THRESHOLD=0.001
SWICO_QWEN_LOAD_BEST_MODEL_AT_END=true

# Keep false on a constrained CPU VM unless you specifically need one merged standalone model.
SWICO_QWEN_MERGE_ADAPTER=false

# Held-out deterministic generation samples
SWICO_QWEN_EVAL_GENERATION_SAMPLES=auto
SWICO_QWEN_GENERATION_MAX_NEW_TOKENS=256
SWICO_QWEN_DATA_QUALITY_REPETITION_THRESHOLD=0.30
SWICO_QWEN_AUDIT_TOKENIZATION=false
SWICO_QWEN_HEALTH_MIN_TERMINATION_RATE=0.95
SWICO_QWEN_HEALTH_MAX_TOKEN_HIT_RATE=0.05
SWICO_QWEN_HEALTH_MAX_REPEATED_4GRAM_RATIO=0.20
SWICO_QWEN_HEALTH_REQUIRE_SCRIPT_ADHERENCE=true

# Runtime memory protection
SWICO_QWEN_MEMORY_GUARD=true
SWICO_QWEN_MEMORY_GUARD_INTERVAL_STEPS=5
SWICO_QWEN_EMERGENCY_AVAILABLE_MEMORY_GIB=4.0
SWICO_QWEN_MAX_PROCESS_RSS_GIB=auto
SWICO_QWEN_MIN_AVAILABLE_MEMORY_GIB=8.0
SWICO_QWEN_MIN_FREE_DISK_GIB=4.0
